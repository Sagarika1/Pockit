# Copy this file to .env.local and fill it in:   copy .env.example .env.local   (Windows)   or   cp .env.example .env.local
# Never commit .env.local. It holds your secrets.

# ---------- PayPal sandbox (required to send payments) ----------
# developer.paypal.com > Apps & Credentials > Sandbox > create an app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# ---------- Login cookies (required) ----------
# Any long random text, 32+ characters
SESSION_SECRET=

# ---------- AI receipt reader (optional) ----------
# Leave blank to run in demo mode: Pockit reads the 8 receipts in /sample-receipts from saved answers.
# Add a key from console.anthropic.com to read any receipt photo and any policy document.
ANTHROPIC_API_KEY=

# ---------- Demo accounts (optional) ----------
# true = on first start, create a demo organization, treasurer, member and a few past requests
SEED_DEMO=true
# A PayPal sandbox PERSONAL account email, so the demo member's payments land somewhere you can see
DEMO_MEMBER_PAYPAL_EMAIL=

# ---------- Text messages (optional) ----------
# Without these, texts are not sent. They show in the treasurer page under "Text messages we've sent".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# or use TWILIO_MESSAGING_SERVICE_SID instead of TWILIO_FROM

# ---------- Link used in text messages (optional) ----------
APP_URL=http://localhost:3000
